<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keep the platform splash theme free of Material 3 theme-attribute color selectors. -->
    <style name="AppTheme.Launcher" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <style name="BaseTheme" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="preferenceTheme">@style/PreferenceTheme</item>
        <item name="switchStyle">@style/SwitchStyle</item>
        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Filled</item>
        <item name="materialAlertDialogTheme">@style/MaterialAlertDialogTheme</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog</item>
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
        <item name="snackbarButtonStyle">@style/Widget.App.SnackbarButton</item>
        <item name="snackbarTextViewStyle">@style/Widget.App.SnackbarTextView</item>
    </style>

    <style name="CardStyle" parent="Widget.Material3.CardView.Filled">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="CardButtonStyle" parent="Widget.Material3.CardView.Filled">
        <item name="cardElevation">1dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.BottomSheetDialog</item>
    </style>

    <style name="Widget.BottomSheetDialog" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BottomSheetDialog</item>
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>

    <style name="ShapeAppearance.BottomSheetDialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="ChipChoiceStyle" parent="Widget.Material3.Chip.Filter">
        <item name="chipIconVisible">true</item>
        <item name="chipBackgroundColor">?attr/colorSecondaryContainer</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
    </style>

    <style name="ShapeAppearanceButton" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="ButtonStyle" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearanceButton</item>
    </style>

    <style name="TabLayoutStyle" parent="Widget.Material3.TabLayout.Secondary">
        <item name="tabIndicator">@drawable/tab_indicator</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabGravity">center</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <style name="ChipActionStyle" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">?attr/colorSurface</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">?attr/colorOutline</item>
        <item name="chipIconTint">?attr/colorPrimary</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="InfoBarStyle" parent="">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="textMessageColor">?attr/colorOnPrimaryContainer</item>
        <item name="textActionColor">?attr/colorOnPrimaryContainer</item>
        <item name="slideEdge">top</item>
    </style>

    <style name="MaterialAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialogStyle</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialogTitleText</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialogBodyText</item>
        <item name="android:checkedTextViewStyle">@style/MaterialAlertDialogBodyText</item>
    </style>

    <style name="MaterialAlertDialogStyle" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/MaterialAlertDialogShapeAppearance</item>
    </style>

    <style name="MaterialAlertDialogShapeAppearance" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="MaterialAlertDialogTitleText" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="MaterialAlertDialogBodyText" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.TextView.ProfileName" parent="android:Widget.TextView">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Widget.TextView.MediaCounter" parent="android:Widget.TextView">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.App.PopupMenu" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
    </style>

    <style name="Widget.TextView.Refresh" parent="android:Widget.TextView">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Widget.App.SnackbarButton" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">?attr/colorOnSurfaceInverse</item>
    </style>

    <style name="Widget.App.SnackbarTextView" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">?attr/colorOnSurfaceInverse</item>
    </style>

    <style name="SwitchStyle" parent="Widget.Material3.CompoundButton.Switch" />

    <style name="ProfileManagerDialogStyle" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">@color/profile_dialog_background</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
