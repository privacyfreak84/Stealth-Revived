<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearanceAppBarLabel" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/lato_semibold</item>
    </style>
    <style name="TextAppearanceBrandAppBar" parent="TextAppearanceAppBarLabel">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/stealth_medium</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="TextAppearanceCategory" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/lato_semibold</item>
    </style>
    <style name="TextAppearancePreference" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/lato_semibold</item>
    </style>
    <style name="TextAppearancePostTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearancePostAuthor" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearancePostInfo" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearancePostDomain" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
