<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">
<data><import type="com.cosmos.unreddit.util.DateUtil"/><variable name="post" type="com.cosmos.unreddit.data.model.db.PostEntity"/></data>
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp">
<TextView android:id="@+id/text_post_author" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@{post.author}" android:textAppearance="@style/TextAppearance.Material3.TitleSmall" android:textColor="?attr/colorPrimary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" tools:text="author"/>
<com.cosmos.unreddit.ui.common.widget.RedditFlairView android:id="@+id/post_flair" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" app:layout_constraintStart_toEndOf="@id/text_post_author" app:layout_constraintTop_toTopOf="@id/text_post_author" app:layout_constraintBottom_toBottomOf="@id/text_post_author"/>
<TextView android:id="@+id/text_subreddit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@{post.subreddit}" android:textAppearance="@style/TextAppearance.Material3.LabelMedium" android:textColor="?attr/colorOnSurfaceVariant" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/text_post_author" tools:text="r/reddit"/>
<TextView android:id="@+id/text_post_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@{DateUtil.getTimeDifference(context, post.created)}" android:textAppearance="@style/TextAppearance.Material3.LabelMedium" android:textColor="?attr/colorOnSurfaceVariant" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="@id/text_subreddit" tools:text="5h"/>
<androidx.constraintlayout.widget.Group android:id="@+id/group_crosspost" android:layout_width="wrap_content" android:layout_height="wrap_content" app:constraint_referenced_ids="text_crosspost,text_crosspost_subreddit,text_crosspost_author"/>
<TextView android:id="@+id/text_crosspost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/post_crosspost" android:textAppearance="@style/TextAppearance.Material3.LabelSmall" android:textColor="?attr/colorPrimary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/text_subreddit"/>
<TextView android:id="@+id/text_crosspost_subreddit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textAppearance="@style/TextAppearance.Material3.LabelSmall" android:textColor="?attr/colorOnSurfaceVariant" app:layout_constraintStart_toEndOf="@id/text_crosspost" app:layout_constraintTop_toTopOf="@id/text_crosspost" tools:text="r/reddit"/>
<TextView android:id="@+id/text_crosspost_author" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textAppearance="@style/TextAppearance.Material3.LabelSmall" android:textColor="?attr/colorOnSurfaceVariant" app:layout_constraintStart_toEndOf="@id/text_crosspost_subreddit" app:layout_constraintTop_toTopOf="@id/text_crosspost" tools:text="u/user"/>
</androidx.constraintlayout.widget.ConstraintLayout></layout>