<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="?attr/colorSurface"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <com.cosmos.unreddit.ui.common.widget.CardButton
        android:id="@+id/menu_card"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/menu_sidebar"
        android:onClick="openAppDrawer"
        app:icon="@drawable/ic_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CardButtonStyle" />

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/fragment_subscriptions_label"
        android:textAppearance="@style/TextAppearanceBrandAppBar"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/menu_card"
        app:layout_constraintTop_toTopOf="parent" />

    <com.cosmos.unreddit.ui.common.widget.SearchInputEditText
        android:id="@+id/search_input"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:backgroundTint="@android:color/transparent"
        android:hint="@string/subscriptions_search_hint"
        android:imeOptions="actionSearch|flagNoPersonalizedLearning"
        android:inputType="text"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/search_card"
        app:layout_constraintStart_toEndOf="@id/menu_card"
        app:layout_constraintTop_toTopOf="parent" />

    <com.cosmos.unreddit.ui.common.widget.CardButton
        android:id="@+id/search_card"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/menu_search"
        app:icon="@drawable/ic_search"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CardButtonStyle" />

    <com.cosmos.unreddit.ui.common.widget.CardButton
        android:id="@+id/cancel_card"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/dialog_cancel"
        android:visibility="gone"
        app:icon="@drawable/ic_close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CardButtonStyle" />
</androidx.constraintlayout.widget.ConstraintLayout>
