<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="16dp">

    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/stealth_medium"
        android:letterSpacing="-0.02"
        android:text="@string/fragment_subscriptions_label"
        android:textAppearance="@style/TextAppearanceBrandAppBar"
        android:textColor="?attr/colorOnSurface"
        android:textSize="26sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/search_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.cosmos.unreddit.ui.common.widget.SearchInputEditText
        android:id="@+id/search_input"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/brand_search_field"
        android:hint="@string/subscriptions_search_hint"
        android:imeOptions="actionSearch|flagNoPersonalizedLearning"
        android:inputType="text"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cancel_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <com.cosmos.unreddit.ui.common.widget.CardButton
        android:id="@+id/search_card"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@string/subscriptions_search_hint"
        app:icon="@drawable/ic_search"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CardButtonStyle" />

    <com.cosmos.unreddit.ui.common.widget.CardButton
        android:id="@+id/cancel_card"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@string/cancel"
        android:visibility="gone"
        app:icon="@drawable/ic_close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CardButtonStyle" />
</androidx.constraintlayout.widget.ConstraintLayout>