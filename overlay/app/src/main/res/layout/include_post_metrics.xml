<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="post"
            type="com.cosmos.unreddit.data.model.db.PostEntity" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/image_vote_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="8dp"
            android:contentDescription="Upvote icon"
            android:tint="?attr/colorOnSurfaceVariant"
            app:srcCompat="@drawable/ic_votes" />

        <TextView
            android:id="@+id/text_post_vote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/image_vote_icon"
            app:layout_constraintBottom_toBottomOf="@id/image_vote_icon"
            app:layout_constraintStart_toEndOf="@id/image_vote_icon"
            android:layout_marginStart="6dp"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="@style/TextAppearancePostInfo"
            android:text="@{post.score}"
            tools:text="12345" />

        <TextView
            android:id="@+id/text_post_ratio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/image_vote_icon"
            app:layout_constraintBottom_toBottomOf="@id/image_vote_icon"
            app:layout_constraintStart_toEndOf="@id/text_post_vote"
            android:layout_marginStart="8dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="@style/TextAppearancePostInfo"
            tools:text="50%" />

        <ImageView
            android:id="@+id/image_comments_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintTop_toTopOf="@id/image_vote_icon"
            app:layout_constraintBottom_toBottomOf="@id/image_vote_icon"
            app:layout_constraintStart_toEndOf="@id/text_post_ratio"
            android:layout_marginStart="16dp"
            android:contentDescription="Comments icon"
            android:tint="?attr/colorOnSurfaceVariant"
            app:srcCompat="@drawable/ic_comments" />

        <TextView
            android:id="@+id/text_post_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/image_vote_icon"
            app:layout_constraintBottom_toBottomOf="@id/image_vote_icon"
            app:layout_constraintStart_toEndOf="@id/image_comments_icon"
            android:layout_marginStart="6dp"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="@style/TextAppearancePostInfo"
            android:text="@{post.commentsNumber}"
            tools:text="1234" />

        <ImageButton
            android:id="@+id/button_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/image_vote_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/brand_post_actions"
            android:tint="?attr/colorOnSurfaceVariant"
            app:srcCompat="@drawable/ic_more" />

        <com.cosmos.unreddit.ui.common.widget.CheckableImageView
            android:id="@+id/button_save"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/brand_post_save"
            app:layout_constraintTop_toTopOf="@id/button_more"
            app:layout_constraintBottom_toBottomOf="@id/button_more"
            app:layout_constraintEnd_toStartOf="@id/button_more"
            android:layout_marginEnd="4dp"
            app:tint="@color/post_action_tint"
            app:srcCompat="@drawable/save" />

        <ImageButton
            android:id="@+id/button_subreddit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            app:layout_constraintTop_toTopOf="@id/button_more"
            app:layout_constraintBottom_toBottomOf="@id/button_more"
            app:layout_constraintEnd_toStartOf="@id/button_save"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/post_open_subreddit"
            android:tint="?attr/colorOnSurfaceVariant"
            app:srcCompat="@drawable/icon_reddit_placeholder" />

        <ImageButton
            android:id="@+id/button_user"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            app:layout_constraintTop_toTopOf="@id/button_more"
            app:layout_constraintBottom_toBottomOf="@id/button_more"
            app:layout_constraintEnd_toStartOf="@id/button_subreddit"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/post_open_user"
            android:tint="?attr/colorOnSurfaceVariant"
            app:srcCompat="@drawable/ic_profile_post" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
