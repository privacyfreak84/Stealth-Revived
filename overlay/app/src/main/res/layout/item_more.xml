<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">
<data><variable name="more" type="com.cosmos.unreddit.data.model.Comment.MoreEntity"/></data>
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/comment_padding_horizontal" android:paddingVertical="12dp">
<View android:id="@+id/comment_color_indicator" android:layout_width="3dp" android:layout_height="0dp" android:layout_marginEnd="12dp" android:background="@drawable/comment_indicator_background" android:backgroundTint="?attr/colorPrimary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/comment_body" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
<TextView android:id="@+id/comment_body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@{@string/comment_more(more.count)}" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="?attr/colorPrimary" app:layout_constraintStart_toEndOf="@id/comment_color_indicator" app:layout_constraintEnd_toStartOf="@id/progress" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" tools:text="More (256)"/>
<ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyle" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="8dp" android:indeterminate="true" app:layout_constraintStart_toEndOf="@id/comment_body" app:layout_constraintTop_toTopOf="@id/comment_body" app:layout_constraintBottom_toBottomOf="@id/comment_body"/>
<TextView android:id="@+id/text_error" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/comment_more_error" android:textAppearance="@style/TextAppearance.Material3.LabelMedium" android:textColor="?attr/colorError" app:layout_constraintStart_toEndOf="@id/progress" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/comment_body" app:layout_constraintBottom_toBottomOf="@id/comment_body"/>
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>