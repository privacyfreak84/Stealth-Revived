<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="12dp">

    <com.cosmos.unreddit.ui.common.widget.CardButton
        android:id="@+id/back_card"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@string/navigation_back"
        app:icon="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CardButtonStyle" />

    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:text="@string/fragment_about_label"
        android:textAppearance="@style/TextAppearanceBrandAppBar"
        android:textColor="?attr/colorOnSurface"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/button_mail"
        app:layout_constraintStart_toEndOf="@id/back_card"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/button_mail"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/about_mail"
        android:tint="?attr/colorOnSurfaceVariant"
        app:srcCompat="@drawable/ic_mail"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/button_matrix"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/button_matrix"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/about_matrix"
        android:tint="?attr/colorOnSurfaceVariant"
        app:srcCompat="@drawable/ic_matrix"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/button_github"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/button_github"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/about_github"
        android:tint="?attr/colorOnSurfaceVariant"
        app:srcCompat="@drawable/ic_github"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>